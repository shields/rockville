{
  $schema: "https://docs.renovatebot.com/renovate-schema.json",
  extends: ["github>shields/right-answers//renovate/base.json5"],
  packageRules: [
    {
      description: "Automerge non-major updates",
      matchUpdateTypes: [
        "minor",
        "patch",
        "pin",
        "digest",
        "lockFileMaintenance",
      ],
      automerge: true,
    },
    {
      description: "Automerge dev dependencies",
      matchDepTypes: ["dev"],
      automerge: true,
    },
  ],
}
